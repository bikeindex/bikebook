        },
        "rated_power": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Continuous/nominal, basis for legal class, in watts",
          "x-unit": "w"
        },
        "peak_power": {
          "type": [
            "integer",
            "null"
          ],
          "description": "In watts",
          "x-unit": "w"
        },
        "max_torque": {
          "type": [
            "integer",
            "null"
          ],
          "description": "In newton-meters",
          "x-unit": "nm"
        },
