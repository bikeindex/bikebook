        "unknown",
        "water_bottle_cage",
        "stem",
        "chain_guide",
        "fairing",
        "lights",
        "bell_noisemaker",
        "basket",
        "chain_tensioners",
        "derailleur",
        "training_wheels",
        "bottom_bracket",
        "brake",
        "hub_guard",
        "generator_dynamo",
        "handlebar",
        "wheel",
        "saddle",
        "rim",
        "axle_nuts",
        "hub",
        "spokes",
        "tube",
        "tire",
        "brake_lever",
        "shift_and_brake_lever",
        "brake_rotor",
        "brake_pad",
        "shifter",
        "throttle",
        "fork",
        "rear_suspension",
        "headset",
        "brake_cable",
        "shift_cable",
        "chain",
        "drive_belt",
        "chainrings",
        "cassette",
        "crankset",
        "pedals",
        "computer",
        "pegs",
        "toe_clips",
        "grips_tape",
        "seatpost_clamp",
        "detangler",
        "kickstand",
        "rack",
        "seatpost",
        "fender",
        "aero_bars",
        "e_vehicle_battery",
        "e_vehicle_charger",
        "e_vehicle_remote",
        "e_vehicle_motor",
        "e_vehicle_wiring_harness",
        "pannier",
        "frame_bag",
        "internal_frame_storage",
        "cargo_bike_side_rails",
        "handlebar_bag",
        "seat_bag",
        "top_tube_bag",
        "child_seat",
        "top_of_rack_bag"
      ]
    },
    "manufacturer": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_group": {
      "type": [
        "string",
        "null"
      ],
      "description": "Model family grouping sibling models/variants"
    },
