          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "assist",
                  "throttle"
                ]
              },
              "availability": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "stock",
                  "upgrade",
                  "app_update",
                  "aftermarket",
                  null
                ],
                "description": "How the buyer gets the mode: stock; upgrade, a mode the maker sells at extra cost, picked at purchase in place of the stock one or bought and fitted later; app_update, an unlock; aftermarket, a third party's"
              },
              "max_speed": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "In kilometers per hour",
                "x-unit": "km/h"
              },
