        },
        "spindle_length": {
          "type": [
            "number",
            "null"
          ],
          "description": "In millimeters",
          "x-unit": "mm"
        },
        "sensor_cadence": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sensor_speed": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "spoke_magnet",
            "rotor_magnet",
            "rim_magnet",
            "hub",
            null
          ]
