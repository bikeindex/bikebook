          "AU",
          "CA",
          "CH",
          "CN",
          "EU",
          "GB",
          "HK",
          "IN",
          "JP",
          "KR",
          "MY",
          "NO",
          "NZ",
          "PH",
          "PY",
          "SG",
          "TH",
          "TW",
          "US",
          "UY"
