  "$id": "https://raw.githubusercontent.com/bikeindex/bikebook/main/schemas/component.json",
  "title": "Bikebook component",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schema_version": {
      "const": "0.24.7"
    },
    "id": {
      "type": "string",
      "pattern": "^c/[a-z0-9_/]+$",
      "description": "Catalog path, prefixed c/: manufacturer slug/first year/model group and model slug"
