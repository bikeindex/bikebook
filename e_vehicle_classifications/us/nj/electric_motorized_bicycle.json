{
  "id": "evc/us/nj/electric_motorized_bicycle",
  "jurisdiction": "US-NJ",
  "name": "Electric Motorized Bicycle",
  "description": "A two-wheeler with fully operable pedals and an electric motor capable of more than 750 watts that can go faster than 28 mph: a pedaled e-moto. The law counts it as a motorcycle.",
  "throttle": true,
  "min_power": 750,
  "restrictions": [
    {
      "rule": "Two wheels, fully operable pedals and an electric motor capable of more than 750 watts",
      "citation": "N.J.S.A. 39:1-1, added by P.L.2025, c.285",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM"
      ]
    },
    {
      "rule": "Capable of more than 28 mph",
      "citation": "N.J.S.A. 39:1-1",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM"
      ]
    },
    {
      "rule": "Not a motorized bicycle or low-speed electric bicycle: the definition of motorcycle names it, so motorcycle rules apply",
      "citation": "N.J.S.A. 39:1-1",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM"
      ]
    },
    {
      "rule": "Riders need a motorcycle license or endorsement",
      "sources": [
        "https://nj.gov/mvc/vehicletopics/motorcycle.htm"
      ]
    },
    {
      "rule": "Riders and passengers must wear a motorcycle helmet",
      "citation": "N.J.S.A. 39:3-76.7",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A3-76.7+Protective+helmets.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A3-76.7+Protective+helmets.%5D39%3A3-76.7+Protective+helmets.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Titled, registered and insured as a motorcycle",
      "sources": [
        "https://nj.gov/mvc/vehicletopics/motorcycle.htm"
      ]
    },
    {
      "rule": "Selling one online is banned for the year after P.L.2025, c.285 took effect",
      "citation": "P.L.2025, c.285",
      "starts_on": "2026-01-19",
      "ends_on": "2027-01-19",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM"
      ]
    },
    {
      "rule": "Selling a kit that turns a low-speed electric bicycle into one is prohibited",
      "citation": "P.L.2025, c.285",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM",
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.%5D39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    }
  ]
}
