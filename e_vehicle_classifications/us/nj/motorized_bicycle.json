{
  "id": "evc/us/nj/motorized_bicycle",
  "jurisdiction": "US-NJ",
  "name": "Motorized Bicycle",
  "description": "A pedal bicycle with an electric motor that assists while pedaling or runs on a throttle, up to 28 mph on a flat surface, or with a helper motor under 50 cc or rated at no more than 1.5 brake horsepower; the Motor Vehicle Commission calls it a moped.",
  "throttle": true,
  "max_speed": 45.06,
  "restrictions": [
    {
      "rule": "A pedal bicycle: an electric motor that assists while the rider pedals or propels it on a throttle, with a top motor-powered speed of 28 mph on a flat surface; or a helper motor under 50 cc or rated at no more than 1.5 brake horsepower",
      "citation": "N.J.S.A. 39:1-1",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM"
      ]
    },
    {
      "rule": "A throttle e-bike, or a pedal-assist e-bike that keeps assisting past 20 mph, lands here rather than in the low-speed electric bicycle category",
      "citation": "N.J.S.A. 39:1-1, as amended by P.L.2025, c.285",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM"
      ]
    },
    {
      "rule": "One with pedals, a motor capable of more than 750 watts and a top speed over 28 mph is an electric motorized bicycle, which the law counts as a motorcycle",
      "citation": "N.J.S.A. 39:1-1",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM"
      ]
    },
    {
      "rule": "Riders must be 15 or older; riders 15 and 16 need a moped (class F) license, and riders 17 and older need any driver's license or a moped license",
      "citation": "N.J.S.A. 39:4-14.3",
      "sources": [
        "https://www.nj.gov/mvc/pdf/about/LawEnforcementAdvisoryEBikeLawImplementation.pdf",
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.3+Regulations+relative+to+motorized+bicycles.%5D39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "The moped license takes a knowledge test and a riding demonstration",
      "citation": "N.J.S.A. 39:4-14.3",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.3+Regulations+relative+to+motorized+bicycles.%5D39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Registered with the Motor Vehicle Commission, with two plate stickers on the front fork",
      "citation": "N.J.S.A. 39:4-14.3i",
      "sources": [
        "https://www.nj.gov/mvc/vehicletopics/ebike.htm",
        "https://www.nj.gov/mvc/pdf/about/LawEnforcementAdvisoryEBikeLawImplementation.pdf",
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.3i.+Registration%3B+requirements%3B+form+and+content+of+certificate%3B+expiration%3B+renewal.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.3i.+Registration%3B+requirements%3B+form+and+content+of+certificate%3B+expiration%3B+renewal.%5D39%3A4-14.3i.+Registration%3B+requirements%3B+form+and+content+of+certificate%3B+expiration%3B+renewal.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "One not registrable before P.L.2025, c.285 had a grace period to register",
      "citation": "P.L.2025, c.285",
      "ends_on": "2026-07-19",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM"
      ]
    },
    {
      "rule": "The owner must carry liability insurance, and the rider must carry the license, registration and insurance card",
      "citation": "N.J.S.A. 39:4-14.3, 39:4-14.3e",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.3e+Compulsory+liability+insurance+coverage&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.3e+Compulsory+liability+insurance+coverage%5D39%3A4-14.3e+Compulsory+liability+insurance+coverage&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu",
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.3+Regulations+relative+to+motorized+bicycles.%5D39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Carries only the operator",
      "citation": "N.J.S.A. 39:4-14.3d",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.3d+Operator+only+on+bicycle&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.3d+Operator+only+on+bicycle%5D39%3A4-14.3d+Operator+only+on+bicycle&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Barred from interstate highways, highways divided by a median, highways posted over 50 mph, and public land where the agency in charge prohibits it",
      "citation": "N.J.S.A. 39:4-14.3",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.3+Regulations+relative+to+motorized+bicycles.%5D39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Bicycle rules otherwise apply, and on a road the rider has the duties of a vehicle driver",
      "citation": "N.J.S.A. 39:4-14.3",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.3+Regulations+relative+to+motorized+bicycles.%5D39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Selling a kit that turns a low-speed electric bicycle into a motorized bicycle is prohibited",
      "citation": "P.L.2025, c.285",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM",
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.%5D39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    }
  ]
