{
  "id": "evc/us/nj/electric_bicycle",
  "jurisdiction": "US-NJ",
  "groups": [
    "evc/us/class_1"
  ],
  "name": "Low-Speed Electric Bicycle",
  "description": "A two-wheeled bicycle with fully operable pedals and an electric motor that helps only while the rider pedals and stops helping at 20 mph.",
  "throttle": false,
  "max_speed": 32.19,
  "restrictions": [
    {
      "rule": "Two wheels and fully operable pedals; the motor assists only while the rider is pedaling and stops assisting at 20 mph",
      "citation": "N.J.S.A. 39:1-1, as amended by P.L.2025, c.285",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM"
      ]
    },
    {
      "rule": "The definition sets no motor wattage limit",
      "citation": "N.J.S.A. 39:1-1",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM"
      ]
    },
    {
      "rule": "An e-bike with a throttle, or with pedal assist past 20 mph up to 28 mph, is a motorized bicycle instead: it also needs a license and registration, must carry liability insurance, and is barred from roads posted over 50 mph",
      "citation": "N.J.S.A. 39:1-1, 39:4-14.3, 39:4-14.3e, 39:4-14.3i",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM",
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.3+Regulations+relative+to+motorized+bicycles.%5D39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu",
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.3i.+Registration%3B+requirements%3B+form+and+content+of+certificate%3B+expiration%3B+renewal.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.3i.+Registration%3B+requirements%3B+form+and+content+of+certificate%3B+expiration%3B+renewal.%5D39%3A4-14.3i.+Registration%3B+requirements%3B+form+and+content+of+certificate%3B+expiration%3B+renewal.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu",
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.3e+Compulsory+liability+insurance+coverage&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.3e+Compulsory+liability+insurance+coverage%5D39%3A4-14.3e+Compulsory+liability+insurance+coverage&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "One with pedals and a motor over 750 watts that can exceed 28 mph is an electric motorized bicycle, which the law counts as a motorcycle",
      "citation": "N.J.S.A. 39:1-1",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM"
      ]
    },
    {
      "rule": "Riders must be 15 or older",
      "citation": "P.L.2025, c.285",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM",
        "https://www.nj.gov/mvc/vehicletopics/ebike.htm",
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.3+Regulations+relative+to+motorized+bicycles.%5D39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Riders need a driver's license or a motorized bicycle (e-bike) license from the Motor Vehicle Commission, which takes a knowledge test and a road test; 15- and 16-year-olds need the e-bike license",
      "citation": "P.L.2025, c.285",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM",
        "https://www.nj.gov/mvc/vehicletopics/ebike.htm",
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.3+Regulations+relative+to+motorized+bicycles.%5D39%3A4-14.3+Regulations+relative+to+motorized+bicycles.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Registered with the Motor Vehicle Commission, with its two plate stickers displayed on the front fork; required since July 19, 2026, after a six-month grace period",
      "citation": "N.J.S.A. 39:4-14.3i; P.L.2025, c.285",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM",
        "https://www.nj.gov/mvc/vehicletopics/ebike.htm",
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.3i.+Registration%3B+requirements%3B+form+and+content+of+certificate%3B+expiration%3B+renewal.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.3i.+Registration%3B+requirements%3B+form+and+content+of+certificate%3B+expiration%3B+renewal.%5D39%3A4-14.3i.+Registration%3B+requirements%3B+form+and+content+of+certificate%3B+expiration%3B+renewal.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "No insurance required",
      "sources": [
        "https://www.nj.gov/mvc/vehicletopics/ebike.htm"
      ]
    },
    {
      "rule": "Riders under 17 must wear a bicycle helmet",
      "citation": "N.J.S.A. 39:4-10.1, 39:4-14.16",
      "sources": [
        "https://nj.gov/transportation/commuter/bike/regulations.shtm",
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-10.1+Bicycle+helmets%2C+requirements.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-10.1+Bicycle+helmets%2C+requirements.%5D39%3A4-10.1+Bicycle+helmets%2C+requirements.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu",
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.%5D39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Ridden on streets, highways and bicycle paths; a county or municipality may ban it from bicycle paths it controls",
      "citation": "N.J.S.A. 39:4-14.16",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.%5D39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "May be parked on a sidewalk if it doesn't block pedestrians",
      "citation": "N.J.S.A. 39:4-14.16",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.%5D39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Kept off natural-surface trails designated non-motorized unless the local authority allows it",
      "citation": "N.J.S.A. 39:4-14.16",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.%5D39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Selling a kit that converts it into a motorized or electric motorized bicycle is prohibited",
      "citation": "N.J.S.A. 39:4-14.16",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.%5D39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Not a motor vehicle; the laws that apply to bicycles otherwise apply to it",
      "citation": "N.J.S.A. 39:1-1, 39:4-14.16",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM",
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.%5D39%3A4-14.16+Operation+of+low-speed+electric+bicycle+or+scooter.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "A bike-share rider 16 or older needs no license, and the rider doesn't register a shared e-bike",
      "citation": "P.L.2025, c.285",
      "sources": [
        "https://pub.njleg.gov/bills/2024/PL25/285_.HTM",
        "https://www.nj.gov/mvc/vehicletopics/ebike.htm"
      ]
    }
  ],
