  "name": "Dirt Bike",
  "description": "A two-wheeled motorcycle designed and manufactured for off-road use only that doesn't meet federal motor vehicle safety standards or EPA on-road emissions standards, such as an off-road e-moto.",
  "throttle": true,
  "restrictions": [
    {
      "rule": "Two wheels, designed and manufactured for off-road use only, and not compliant with federal motor vehicle safety standards or EPA on-road emissions standards",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "N.J.S.A. 39:3C-1",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A3C-1+Definitions.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A3C-1+Definitions.%5D39%3A3C-1+Definitions.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Registered with the Motor Vehicle Commission to ride on public lands or waters or to cross a public highway",
      "categories": [
        "rider_rule",
        "top_rule_1"
      ],
      "citation": "N.J.S.A. 39:3C-3",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A3C-3+Registration+required%3B+fees.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A3C-3+Registration+required%3B+fees.%5D39%3A3C-3+Registration+required%3B+fees.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "The rider must carry proof of liability insurance and current registration",
      "categories": [
        "rider_rule"
      ],
      "sources": [
        "https://www.nj.gov/mvc/vehicletopics/mopedatv.htm"
      ]
    },
    {
      "rule": "Riders must be 14 or older on public lands or waters or crossing a public highway",
      "categories": [
        "rider_rule"
      ],
      "citation": "N.J.S.A. 39:3C-16",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A3C-16+Age+requirements.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A3C-16+Age+requirements.%5D39%3A3C-16+Age+requirements.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Riders under 18 must complete an approved safety course and carry the certificate while riding",
      "categories": [
        "rider_rule"
      ],
      "citation": "N.J.S.A. 39:3C-16",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A3C-16+Age+requirements.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A3C-16+Age+requirements.%5D39%3A3C-16+Age+requirements.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "For off-road use only",
      "categories": [
        "vehicle_definition"
      ],
      "sources": [
        "https://www.nj.gov/mvc/vehicletopics/mopedatv.htm"
      ]
    },
    {
      "rule": "Never ridden on a limited-access highway or its right-of-way; on another public street only to cross it directly, registered, after a full stop, or alongside it to reach where it's ridden when it can't be unloaded closer",
      "categories": [
        "rider_rule",
        "top_rule_0"
      ],
      "citation": "N.J.S.A. 39:3C-17",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A3C-17+Operational+limitations.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A3C-17+Operational+limitations.%5D39%3A3C-17+Operational+limitations.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Ridden on a public street, highway or right-of-way, it's impounded for at least 7 days, released on proof of registration and insurance and a $500 fee plus towing and storage; a repeat offense means at least 14 days and $750, and one unclaimed after 30 days may be auctioned",
      "categories": [
        "enforcement"
      ],
      "citation": "N.J.S.A. 39:3C-35, from P.L.2019, c.505",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A3C-35+Impoundment+of+certain+vehicles%2C+disposition.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A3C-35+Impoundment+of+certain+vehicles%2C+disposition.%5D39%3A3C-35+Impoundment+of+certain+vehicles%2C+disposition.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "A municipality may by ordinance make one ridden on a public street or highway contraband, forfeited and possibly destroyed",
      "categories": [
        "enforcement",
        "legal_context"
      ],
      "citation": "N.J.S.A. 39:3C-35",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A3C-35+Impoundment+of+certain+vehicles%2C+disposition.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A3C-35+Impoundment+of+certain+vehicles%2C+disposition.%5D39%3A3C-35+Impoundment+of+certain+vehicles%2C+disposition.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
      ]
    },
    {
      "rule": "Ridden on public lands against the off-road vehicle law, it may be impounded for at least 48 hours with a $500 fee, 96 hours and $750 for a second offense, and forfeited and auctioned, with a $1,000 fee, for a third",
      "categories": [
        "enforcement"
      ],
      "citation": "N.J.S.A. 39:3C-34",
      "sources": [
        "https://lis.njleg.state.nj.us/nxt/gateway.dll?xhitlist_vq=39%3A3C-34+Additional+fines%2C+impoundment.&f=xhitlist&xhitlist_q=%5BRank+100%5D%5BDomain%3A+39%3A3C-34+Additional+fines%2C+impoundment.%5D39%3A3C-34+Additional+fines%2C+impoundment.&xhitlist_x=advanced&xhitlist_s=relevance-weight&xhitlist_mh=99999&xhitlist_d=&xhitlist_hc=%5BXML%5D%5BKwic%2C10000%5D&xhitlist_xsl=xhitlist.xsl&xhitlist_vpc=first&xhitlist_vps=20&xhitlist_sel=title%3Bpath%3Brelevance-weight%3Bcontent-type%3Bhome-title%3Bitem-bookmark%3Btitle-path%3Bhit-context&vid=Publish%3A10.1048%2FEnu"
