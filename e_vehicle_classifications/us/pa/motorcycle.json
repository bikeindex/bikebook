  "name": "Motorcycle",
  "description": "A motor vehicle with a seat or saddle designed to travel on no more than three wheels; an electric one whose motor produces more than 5 brake horsepower (about 3,750 W) is a full motorcycle rather than a motor-driven cycle.",
  "throttle": true,
  "min_power": 3750,
  "restrictions": [
    {
      "rule": "A seat or saddle, and no more than three wheels on the ground",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Pennsylvania Consolidated Statutes Title 75 §102",
      "sources": [
        "https://www.palegis.us/statutes/consolidated/view-statute?txtType=PDF&ttl=75&div=00.&chpt=1&sctn=2&subsctn=0"
      ]
    },
    {
      "rule": "Its motor produces more than 5 brake horsepower (about 3,750 W)",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Pennsylvania Consolidated Statutes Title 75 §102",
      "sources": [
        "https://www.palegis.us/statutes/consolidated/view-statute?txtType=PDF&ttl=75&div=00.&chpt=1&sctn=2&subsctn=0"
      ]
    },
    {
      "rule": "Riders need a Class M license",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Pennsylvania Consolidated Statutes Title 75 §1504",
      "sources": [
        "https://www.palegis.us/statutes/consolidated/view-statute?txtType=PDF&ttl=75&div=00.&chpt=15&sctn=4&subsctn=0"
      ]
    },
    {
      "rule": "Riders under 21 must wear a motorcycle helmet, as must older riders unless they've held a motorcycle license for two years or completed an approved rider safety course",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Pennsylvania Consolidated Statutes Title 75 §3525",
      "sources": [
        "https://www.palegis.us/statutes/consolidated/view-statute?txtType=PDF&ttl=75&div=00.&chpt=35&sctn=25&subsctn=0"
      ]
    },
    {
      "rule": "Riders must wear eye protection",
      "categories": [
        "rider_rule"
      ],
      "citation": "Pennsylvania Consolidated Statutes Title 75 §3525",
      "sources": [
        "https://www.palegis.us/statutes/consolidated/view-statute?txtType=PDF&ttl=75&div=00.&chpt=35&sctn=25&subsctn=0"
      ]
    },
    {
      "rule": "Titled and registered with PennDOT for $18 a year, with the registration card carried while riding, and must carry insurance",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Pennsylvania Consolidated Statutes Title 75 §§1301, 1311, 1786, 1914",
      "sources": [
        "https://www.palegis.us/statutes/consolidated/view-statute?txtType=PDF&ttl=75&div=00.&chpt=13&sctn=1&subsctn=0",
        "https://www.palegis.us/statutes/consolidated/view-statute?txtType=PDF&ttl=75&div=00.&chpt=13&sctn=11&subsctn=0",
        "https://www.palegis.us/statutes/consolidated/view-statute?txtType=PDF&ttl=75&div=00.&chpt=19&sctn=14&subsctn=0",
        "https://www.palegis.us/statutes/consolidated/view-statute?txtType=PDF&ttl=75&div=00.&chpt=17&sctn=86&subsctn=0"
      ]
    },
    {
      "rule": "One built only for off-road use, without the federal on-road certification to register it, is a dirt bike instead, which its ATV law doesn't cover and which may not be ridden on a highway",
      "categories": [
        "vehicle_definition"
      ],
