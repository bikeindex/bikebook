{
  "id": "evc/us/md/motorcycle",
  "jurisdiction": "US-MD",
  "groups": [
    "evc/motor_driven_cycle",
    "evc/motorcycle"
  ],
  "name": "Motorcycle",
  "description": "A motor vehicle with a seat or saddle, designed to travel on no more than three wheels at speeds over 35 mph, of a type required to meet the federal safety standards for motorcycles.",
  "throttle": true,
  "restrictions": [
    {
      "rule": "A seat or saddle, no more than three wheels on the ground, and designed to go faster than 35 mph",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Maryland Transportation Article §11-136",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-136&enactments=false"
      ]
    },
    {
      "rule": "Its motor's power doesn't matter, so a light electric motorcycle designed to go faster than 35 mph is one; Maryland has no separate motor-driven cycle class",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Maryland Transportation Article §11-136",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-136&enactments=false"
      ]
    },
    {
      "rule": "Of a type required to meet the federal motor vehicle safety standards for motorcycles; an off-road dirt bike that can't be registered as one is an off-highway recreational vehicle",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Maryland Transportation Article §§11-136, 11-140.1",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-136&enactments=false",
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-140.1&enactments=false"
      ]
    },
    {
      "rule": "Riders need a Class M driver's license, earned by experience or an approved basic motorcycle safety course",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Maryland Transportation Article §§16-104.1, 16-105",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=16-104.1&enactments=false",
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=16-105&enactments=false"
      ]
    },
    {
      "rule": "A rider on a motorcycle learner's permit may carry only a qualifying licensed supervisor",
      "categories": [
        "rider_rule"
      ],
      "citation": "Maryland Transportation Article §16-105",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=16-105&enactments=false"
      ]
    },
    {
      "rule": "Every rider and passenger must wear an approved helmet, and the operator must wear approved eye protection unless it has a windscreen",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Maryland Transportation Article §21-1306",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=21-1306&enactments=false"
      ]
    },
    {
      "rule": "Titled and registered as a Class D (motorcycle) vehicle, and must carry liability insurance",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Maryland Transportation Article §§13-402, 13-915, 17-103, 17-104",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=17-103&enactments=false",
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=13-402&enactments=false",
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=13-915&enactments=false",
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=17-104&enactments=false"
      ]
    },
    {
      "rule": "In Baltimore City, an unregistered one may not be ridden on any public or private property and must be kept locked or wheel-clamped; one ridden there can be seized and forfeited",
      "categories": [
        "rider_rule",
        "enforcement"
      ],
      "jurisdiction": "US-MD-04000",
      "citation": "Baltimore City Code Article 19 §§40-1, 40-6, 40-11",
      "sources": [
        "https://codes.baltimorecity.gov/us/md/cities/baltimore/code/19/40-1",
        "https://codes.baltimorecity.gov/us/md/cities/baltimore/code/19/40-6",
        "https://codes.baltimorecity.gov/us/md/cities/baltimore/code/19/40-11"
      ]
    }
  ]
}
