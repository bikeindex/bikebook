{
  "id": "evc/us/md/moped",
  "jurisdiction": "US-MD",
  "name": "Moped",
  "description": "A bicycle designed to be operated by human power with the assistance of a motor rated 1.5 brake horsepower (1,125 W) or less, with pedals that drive the rear wheel. A pedal e-bike over an electric bicycle's limits but under 1.5 brake horsepower lands here. It counts as a bicycle and isn't a motor vehicle.",
  "throttle": true,
  "max_power": 1125,
  "restrictions": [
    {
      "rule": "Pedals that mechanically drive the rear wheel or wheels, and two or three wheels, one more than 14 inches in diameter",
      "citation": "Maryland Transportation Article §11-134.1",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-134.1&enactments=false"
      ]
    },
    {
      "rule": "A motor rated 1.5 brake horsepower (1,125 W) or less",
      "citation": "Maryland Transportation Article §11-134.1",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-134.1&enactments=false"
      ]
    },
    {
      "rule": "A bicycle, not a motor vehicle, under Maryland law",
      "citation": "Maryland Transportation Article §11-104",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-104&enactments=false",
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-135&enactments=false"
      ]
    },
    {
      "rule": "Riders need a driver's license of any class or a moped operator's permit",
      "citation": "Maryland Transportation Article §16-101",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=16-101&enactments=false"
      ]
    },
    {
      "rule": "Every rider and passenger must wear a helmet meeting FMVSS 218, and the operator must wear approved eye protection unless it has a windscreen",
      "citation": "Maryland Transportation Article §21-1306.1",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=21-1306.1&enactments=false"
      ]
    },
    {
      "rule": "Titled with the MVA, which issues a decal to display on it; the owner must certify at titling that it carries the required liability insurance",
      "citation": "Maryland Transportation Article §§13-102, 13-104, 13-106",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=13-104&enactments=false",
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=13-106&enactments=false",
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=13-102&enactments=false"
      ]
    },
    {
      "rule": "Must use a smooth-paved bike lane where there is one",
      "citation": "Maryland Transportation Article §21-1205.1",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-104&enactments=false",
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=21-1205.1&enactments=false"
      ]
    },
    {
      "rule": "Barred from roads posted above 50 mph except on their shoulders, and from expressways",
      "citation": "Maryland Transportation Article §21-1205.1",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-104&enactments=false",
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=21-1205.1&enactments=false"
      ]
    }
  ]
}
