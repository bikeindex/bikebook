{
  "id": "evc/us/md/motor_scooter",
  "jurisdiction": "US-MD",
  "groups": [
    "evc/moped"
  ],
  "name": "Motor Scooter",
  "description": "A nonpedal vehicle with a seat, two wheels, a step-through chassis, an automatic transmission and a motor rated 2.7 brake horsepower (2,025 W) or less, ridden no faster than 30 mph. An electric scooter-style moped without pedals lands here. It isn't a motor vehicle.",
  "throttle": true,
  "max_power": 2025,
  "restrictions": [
    {
      "rule": "No pedals: a seat, two wheels (one 10 inches or more in diameter), a step-through chassis and an automatic transmission",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Maryland Transportation Article §11-134.5",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-134.5&enactments=false"
      ]
    },
    {
      "rule": "Maryland's moped needs pedals, so an electric moped without them that has a step-through chassis is a motor scooter",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Maryland Transportation Article §§11-134.1, 11-134.5",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-134.1&enactments=false",
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-134.5&enactments=false"
      ]
    },
    {
      "rule": "A motor rated 2.7 brake horsepower (2,025 W) or less",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Maryland Transportation Article §11-134.5",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-134.5&enactments=false"
      ]
    },
    {
      "rule": "Excludes vehicles manufactured for off-road use, such as an off-road motorcycle",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Maryland Transportation Article §11-134.5",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-134.5&enactments=false"
      ]
    },
    {
      "rule": "May not be ridden faster than 30 mph",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Maryland Transportation Article §21-1205.1",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=21-1205.1&enactments=false"
      ]
    },
    {
      "rule": "Riders need a driver's license of any class or a moped operator's permit",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Maryland Transportation Article §16-101",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=16-101&enactments=false"
      ]
    },
    {
      "rule": "Every rider and passenger must wear a helmet meeting FMVSS 218, and the operator must wear approved eye protection unless it has a windscreen",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Maryland Transportation Article §21-1306.1",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=21-1306.1&enactments=false"
      ]
    },
    {
      "rule": "Titled with the MVA, which issues a decal to display on it; the owner must certify at titling that it carries the required liability insurance",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Maryland Transportation Article §§13-104, 13-106",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=13-104&enactments=false",
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=13-106&enactments=false"
      ]
    },
    {
      "rule": "Must use a smooth-paved bike lane where there is one, keeping as far right as practicable when slower than traffic",
      "categories": [
        "rider_rule"
      ],
      "citation": "Maryland Transportation Article §§21-1205, 21-1205.1",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=21-1205&enactments=false",
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=21-1205.1&enactments=false"
      ]
    },
    {
      "rule": "Barred from roads posted above 50 mph except on their shoulders, and from expressways",
      "categories": [
        "rider_rule"
      ],
      "citation": "Maryland Transportation Article §21-1205.1",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=21-1205.1&enactments=false"
      ]
    }
  ],
  "sources": [
    "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-135&enactments=false"
  ]
}
