{
  "id": "evc/us/md/off_highway_recreational_vehicle",
  "jurisdiction": "US-MD",
  "groups": [
    "evc/off_highway_motorcycle"
  ],
  "name": "Off-Highway Recreational Vehicle",
  "description": "A vehicle built for off-highway recreation: an ATV, a side-by-side, a snowmobile, or a motorcycle designed for off-highway use that can't be registered as a motorcycle, commonly known as a dirt bike. An off-road electric dirt bike lands here.",
  "throttle": true,
  "restrictions": [
    {
      "rule": "Includes a motorcycle designed for off-highway operation that isn't eligible for registration as a Class D (motorcycle) vehicle, with no limit on power or speed",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Maryland Transportation Article §11-140.1",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-140.1&enactments=false"
      ]
    },
    {
      "rule": "Excludes electric bicycles",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Maryland Transportation Article §11-140.1",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-140.1&enactments=false"
      ]
    },
    {
      "rule": "One bought on or after October 1, 2010 must be titled with the MVA, applying electronically",
      "categories": [
        "rider_rule",
        "top_rule_1"
      ],
      "citation": "Maryland Transportation Article §§13-102, 13-104",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=13-102&enactments=false",
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=13-104&enactments=false"
      ]
    },
    {
      "rule": "Can't be registered for the road, so it may not be driven on a highway",
      "categories": [
        "rider_rule",
        "top_rule_0"
      ],
      "citation": "Maryland Transportation Article §§11-140.1, 13-401",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=11-140.1&enactments=false",
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=13-401&enactments=false"
      ]
    },
    {
      "rule": "Each county and Baltimore City may regulate where an off-the-road motorcycle is ridden, require it to be registered and charge a fee",
      "categories": [
        "legal_context"
      ],
      "citation": "Maryland Transportation Article §25-102.1",
      "sources": [
        "https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=gtr&section=25-102.1&enactments=false"
      ]
    },
    {
      "rule": "In Baltimore City, no one may ride a dirt bike on any public or private property, or keep one that isn't locked or wheel-clamped; one ridden there can be seized and forfeited",
      "categories": [
        "rider_rule",
        "enforcement",
        "top_rule_2"
      ],
      "jurisdiction": "US-MD-04000",
      "citation": "Baltimore City Code Article 19 §§40-1, 40-6, 40-11",
      "sources": [
        "https://codes.baltimorecity.gov/us/md/cities/baltimore/code/19/40-1",
        "https://codes.baltimorecity.gov/us/md/cities/baltimore/code/19/40-6",
        "https://codes.baltimorecity.gov/us/md/cities/baltimore/code/19/40-11"
      ]
    }
  ]
}
