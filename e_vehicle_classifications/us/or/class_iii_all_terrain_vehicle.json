{
  "id": "evc/us/or/class_iii_all_terrain_vehicle",
  "jurisdiction": "US-OR",
  "groups": [
    "evc/off_highway_motorcycle"
  ],
  "name": "Class III All-Terrain Vehicle",
  "description": "A motorcycle that travels on two tires while it's being ridden off the highway, which is how Oregon classes an electric dirt bike on trails and riding areas.",
  "throttle": true,
  "restrictions": [
    {
      "rule": "A two-wheeled motorcycle being ridden off the highway; no limit on motor power or speed",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Oregon Revised Statutes §801.194",
      "sources": [
        "https://www.oregonlegislature.gov/bills_laws/ors/ors801.html"
      ]
    },
    {
      "rule": "Needs an ATV operating permit and decal from Oregon Parks and Recreation, valid for two years, to ride where the land manager requires one",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Oregon Revised Statutes §821.195",
      "sources": [
        "https://www.oregonlegislature.gov/bills_laws/ors/ors821.html",
        "https://www.oregon.gov/oprd/ATV/Pages/ATV-faq.aspx"
      ]
    },
    {
      "rule": "Riders 16 or older need an ATV safety education card on public lands",
      "categories": [
        "rider_rule"
      ],
      "citation": "Oregon Revised Statutes §821.172",
      "sources": [
        "https://www.oregonlegislature.gov/bills_laws/ors/ors821.html",
        "https://www.oregon.gov/oprd/ATV/Pages/ATV-faq.aspx"
      ]
    },
    {
      "rule": "Riders under 16 need the card and a hands-on course, and must be accompanied by someone 18 or older who holds an ATV card",
      "categories": [
        "rider_rule"
      ],
      "citation": "Oregon Revised Statutes §821.172",
      "sources": [
        "https://www.oregonlegislature.gov/bills_laws/ors/ors821.html",
        "https://www.oregon.gov/oprd/ATV/Pages/ATV-faq.aspx"
      ]
    },
    {
      "rule": "Riders under 7 may not ride on public lands",
      "categories": [
        "rider_rule"
      ],
      "citation": "Oregon Revised Statutes §821.172",
      "sources": [
        "https://www.oregonlegislature.gov/bills_laws/ors/ors821.html",
        "https://www.oregon.gov/oprd/ATV/Pages/ATV-faq.aspx"
      ]
    },
    {
      "rule": "Riders and passengers under 18 must wear a DOT motorcycle helmet with the chin strap fastened",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Oregon Revised Statutes §821.202",
      "sources": [
        "https://www.oregonlegislature.gov/bills_laws/ors/ors801.html",
        "https://www.oregonlegislature.gov/bills_laws/ors/ors821.html"
      ]
    },
    {
      "rule": "Kept off highways, their shoulders and medians, except to cross, load or unload, or where posted open to all-terrain vehicles",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Oregon Revised Statutes §§821.190, 821.200",
      "sources": [
        "https://www.oregonlegislature.gov/bills_laws/ors/ors821.html"
      ]
    },
    {
      "rule": "No insurance needed off the highway",
      "categories": [
        "rider_rule"
      ],
      "sources": [
        "https://www.oregonlegislature.gov/bills_laws/ors/ors806.html",
        "https://www.oregon.gov/oprd/ATV/Pages/ATV-faq.aspx"
      ]
    }
  ]
}
