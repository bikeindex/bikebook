{
  "id": "evc/us/mt/motor_driven_cycle",
  "jurisdiction": "US-MT",
  "groups": [
    "evc/motor_driven_cycle"
  ],
  "name": "Motor-Driven Cycle",
  "description": "A motorcycle, including a motor scooter, whose motor produces 5 horsepower (3,750 W) or less: the light end of the motorcycle category, regulated as a motorcycle. Bicycles and mopeds are excluded.",
  "throttle": true,
  "max_power": 3750,
  "restrictions": [
    {
      "rule": "A motorcycle: a seat or saddle and no more than three wheels on the ground",
      "citation": "Montana Code Annotated §61-1-101(43), (44)",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0010/part_0010/section_0010/0610-0010-0010-0010.html"
      ]
    },
    {
      "rule": "Its motor produces 5 horsepower (3,750 W) or less",
      "citation": "Montana Code Annotated §61-1-101(44)",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0010/part_0010/section_0010/0610-0010-0010-0010.html"
      ]
    },
    {
      "rule": "Pedals with no more than 2 brake horsepower and a 30 mph top speed make it a moped instead",
      "citation": "Montana Code Annotated §61-1-101(44)",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0010/part_0010/section_0010/0610-0010-0010-0010.html",
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0080/part_0010/section_0020/0610-0080-0010-0020.html"
      ]
    },
    {
      "rule": "Riders need a driver's license with a motorcycle endorsement, except on a three-wheeled motorcycle or autocycle",
      "citation": "Montana Code Annotated §61-5-102(2)",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0050/part_0010/section_0020/0610-0050-0010-0020.html"
      ]
    },
    {
      "rule": "Riders and passengers under 18 must wear a helmet",
      "citation": "Montana Code Annotated §61-9-417",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0090/part_0040/section_0170/0610-0090-0040-0170.html"
      ]
    },
    {
      "rule": "Registered as a motorcycle, and the owner must carry liability insurance",
      "citation": "Montana Code Annotated §§61-3-301, 61-6-301",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0060/part_0030/section_0010/0610-0060-0030-0010.html",
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0030/part_0030/section_0010/0610-0030-0030-0010.html"
      ]
    },
    {
      "rule": "One designed for off-road recreation is an off-highway vehicle unless it's modified to meet the highway equipment standards and registered for the road",
      "citation": "Montana Code Annotated §61-1-101(43)",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0010/part_0010/section_0010/0610-0010-0010-0010.html"
      ]
    }
  ]
}
