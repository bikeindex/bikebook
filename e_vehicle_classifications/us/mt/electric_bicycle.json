{
  "id": "evc/us/mt/electric_bicycle",
  "jurisdiction": "US-MT",
  "groups": [
    "evc/us/class_1",
    "evc/us/class_2"
  ],
  "name": "Electrically Assisted Bicycle",
  "description": "A two-wheeled ride whose electric motor can propel it and a 170-pound rider no faster than 20 mph on a paved, level surface. Montana has no class 1/2/3 system: the definition counts it as a bicycle, so it rides under bicycle law.",
  "throttle": true,
  "max_speed": 32.19,
  "restrictions": [
    {
      "rule": "Two tandem wheels and an electric motor; the definition draws no line between a throttle and pedal assist",
      "citation": "Montana Code Annotated §61-8-102(7)",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0080/part_0010/section_0020/0610-0080-0010-0020.html"
      ]
    },
    {
      "rule": "The motor can't propel it and a 170-pound rider faster than 20 mph on a paved, level surface",
      "citation": "Montana Code Annotated §61-8-102(7)",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0080/part_0010/section_0020/0610-0080-0010-0020.html"
      ]
    },
    {
      "rule": "No motor wattage limit in the definition",
      "citation": "Montana Code Annotated §61-8-102(7)",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0080/part_0010/section_0020/0610-0080-0010-0020.html"
      ]
    },
    {
      "rule": "No classes: a 28 mph pedal-assist (class 3) e-bike fails the 20 mph test and isn't an electrically assisted bicycle",
      "citation": "Montana Code Annotated §61-8-102(7)",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0080/part_0010/section_0020/0610-0080-0010-0020.html"
      ]
    },
    {
      "rule": "A faster machine with pedals, a power source of at most 2 brake horsepower and a top speed of 30 mph is a moped instead",
      "citation": "Montana Code Annotated §61-8-102(14)",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0080/part_0010/section_0020/0610-0080-0010-0020.html"
      ]
    },
    {
      "rule": "Counts as a bicycle under state law, with a bicycle's rights and duties",
      "citation": "Montana Code Annotated §61-8-102(2)",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0080/part_0010/section_0020/0610-0080-0010-0020.html",
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0080/part_0060/section_0020/0610-0080-0060-0020.html"
      ]
    },
    {
      "rule": "No driver's license, registration or insurance",
      "citation": "Montana Code Annotated §61-1-101(41)",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0080/part_0010/section_0020/0610-0080-0010-0020.html",
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0010/part_0010/section_0010/0610-0010-0010-0010.html",
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0060/part_0030/section_0010/0610-0060-0030-0010.html"
      ]
    },
    {
      "rule": "No statewide minimum age",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0080/part_0010/section_0020/0610-0080-0010-0020.html"
      ]
    },
    {
      "rule": "No statewide helmet requirement",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0090/part_0040/section_0170/0610-0090-0040-0170.html"
      ]
    },
    {
      "rule": "Ridden wherever bicycles are allowed; federal land managers may still treat it as motorized on their trails",
      "citation": "Montana Code Annotated §61-8-102(2)",
      "sources": [
        "https://mca.legmt.gov/bills/mca/title_0610/chapter_0080/part_0010/section_0020/0610-0080-0010-0020.html",
        "https://www.blm.gov/programs/recreation/e-bikes"
      ]
    }
  ]
}
