{
  "id": "evc/us/ga/off_road_vehicle",
  "jurisdiction": "US-GA",
  "groups": [
    "evc/off_highway_motorcycle"
  ],
  "name": "Off-Road Vehicle",
  "description": "Any motorized vehicle designed for or capable of cross-country travel over natural terrain and not intended for use mainly on public roads, explicitly including two-wheel vehicles powered by any source but muscle or wind, so an electric dirt bike built for off-road use falls here. No limit on power or speed.",
  "throttle": true,
  "restrictions": [
    {
      "rule": "Designed for or capable of cross-country travel over land or other natural terrain, and not intended for use mainly on public roads; two-wheel vehicles and any power source other than muscle or wind are included",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "O.C.G.A. §40-7-3",
      "sources": [
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-7-3/"
      ]
    },
    {
      "rule": "No limit on motor power or speed",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "O.C.G.A. §40-7-3",
      "sources": [
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-7-3/"
      ]
    },
    {
      "rule": "Must have operative brakes and a muffler or other silencing equipment",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "O.C.G.A. §40-7-4",
      "sources": [
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-7-4/"
      ]
    },
    {
      "rule": "Not allowed on private property without the owner's or agent's express written permission",
      "categories": [
        "rider_rule",
        "top_rule_1"
      ],
      "citation": "O.C.G.A. §40-7-4",
      "sources": [
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-7-4/"
      ]
    },
    {
      "rule": "Not allowed in a perennial stream except to cross it directly",
      "categories": [
        "rider_rule"
      ],
      "citation": "O.C.G.A. §40-7-4",
      "sources": [
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-7-4/"
      ]
    },
    {
      "rule": "Cities and counties may set times and zones of use by ordinance, and state agencies on the land they manage",
      "categories": [
        "legal_context"
      ],
      "citation": "O.C.G.A. §40-7-5",
      "sources": [
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-7-5/"
      ]
    },
    {
      "rule": "A violation is a civil penalty of at least $25, not a crime",
      "categories": [
        "enforcement"
      ],
      "citation": "O.C.G.A. §40-7-6",
      "sources": [
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-7-6/"
      ]
    },
    {
      "rule": "The Act sets no registration, sticker, license, age, helmet or safety-course requirement",
      "categories": [
        "rider_rule"
      ],
      "citation": "O.C.G.A. §§40-7-1 through 40-7-6",
      "sources": [
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-7-3/",
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-7-4/",
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-7-5/",
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-7-6/",
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-7-1/",
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-7-2/"
      ]
    },
    {
      "rule": "Georgia issues no title for a vehicle not sold for lawful highway use",
      "categories": [
        "rider_rule"
      ],
      "citation": "O.C.G.A. §40-3-4(16)",
      "sources": [
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-3-4/"
      ]
    },
    {
      "rule": "Ridden on a public road, a two-wheeled one is a motorcycle and needs registration and a Class M license",
      "categories": [
        "rider_rule",
        "vehicle_definition",
        "top_rule_0"
      ],
      "citation": "O.C.G.A. §§40-1-1(29), 40-2-20",
      "sources": [
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-1-1/",
        "https://codes.findlaw.com/ga/title-40-motor-vehicles-and-traffic/ga-code-sect-40-2-20/",
        "https://dds.georgia.gov/georgia-licenses-ids-and-permits/new-license-id-or-permit/how-do-i-class-m-motorcycle-license"
      ]
    }
  ]
}
