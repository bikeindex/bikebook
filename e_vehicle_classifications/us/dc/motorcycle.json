{
  "id": "evc/us/dc/motorcycle",
  "jurisdiction": "US-DC",
  "groups": [
    "evc/motor_driven_cycle",
    "evc/motorcycle"
  ],
  "name": "Motorcycle",
  "description": "A motor vehicle with a seat or saddle and two or three wheels on the ground; a motor-driven cycle or motorized bicycle operated past 30 mph is one.",
  "throttle": true,
  "restrictions": [
    {
      "rule": "A seat or saddle and two or three wheels on the ground; a three-wheeled vehicle with a cab and windshield isn't one",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "D.C. Code §31-2402(16); 18 DCMR 9901.1",
      "sources": [
        "https://lims.dccouncil.gov/downloads/LIMS/26751/Signed_Act/B19-0995-SignedAct.pdf?Id=105862",
        "https://code.dccouncil.gov/us/dc/council/code/sections/31-2402"
      ]
    },
    {
      "rule": "A motor-driven cycle or motorized bicycle becomes one when operated past 30 mph, and a light electric motorcycle whose motor can propel it past 30 mph is one whatever its power",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "D.C. Code §31-2402(16); 18 DCMR 9901.1",
      "sources": [
        "https://lims.dccouncil.gov/downloads/LIMS/26751/Signed_Act/B19-0995-SignedAct.pdf?Id=105862",
        "https://code.dccouncil.gov/us/dc/council/code/sections/31-2402"
      ]
    },
    {
      "rule": "Riders need a motorcycle endorsement",
      "categories": [
        "rider_rule"
      ],
      "citation": "D.C. Code §50-1401.01(d)",
      "sources": [
        "https://lims.dccouncil.gov/downloads/LIMS/26751/Signed_Act/B19-0995-SignedAct.pdf?Id=105862",
        "https://code.dccouncil.gov/us/dc/council/code/sections/50-1401.01"
      ]
    },
    {
      "rule": "Rider and passenger must wear a protective helmet",
      "categories": [
        "rider_rule"
      ],
      "citation": "D.C. Law 19-290",
      "sources": [
        "https://lims.dccouncil.gov/downloads/LIMS/26751/Signed_Act/B19-0995-SignedAct.pdf?Id=105862"
      ]
    },
    {
      "rule": "Carries a passenger only on a seat designed for one, or a sidecar",
      "categories": [
        "rider_rule"
      ],
      "citation": "D.C. Law 19-290",
      "sources": [
        "https://lims.dccouncil.gov/downloads/LIMS/26751/Signed_Act/B19-0995-SignedAct.pdf?Id=105862"
      ]
    },
    {
      "rule": "Registered and plated like any motor vehicle, and the DMV registers only one that meets federal motor vehicle safety standards, which an uncertified e-moto doesn't; riding one without its registration and tags is punishable by a fine of up to $1,000 and 30 days in jail",
      "categories": [
        "rider_rule",
        "enforcement",
        "top_rule_0"
      ],
      "citation": "D.C. Code §50-1501.04",
      "sources": [
        "https://code.dccouncil.gov/us/dc/council/code/sections/50-1501.04",
        "https://dmv.dc.gov/nontraditionalvehicles",
        "https://dmv.dc.gov/service/registering-motorcycles-and-motorized-bicycles"
      ]
    },
    {
      "rule": "A motor vehicle under DC's compulsory insurance law",
      "categories": [
        "rider_rule"
      ],
      "citation": "D.C. Code §31-2402(16)",
      "sources": [
        "https://code.dccouncil.gov/us/dc/council/code/sections/31-2402"
      ]
    }
  ],
  "sources": [
    "https://code.dccouncil.gov/us/dc/council/code/sections/50-2201.02",
    "https://code.dccouncil.gov/us/dc/council/laws/19-290"
  ]
}
