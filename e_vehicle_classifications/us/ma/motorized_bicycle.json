{
  "id": "evc/us/ma/motorized_bicycle",
  "jurisdiction": "US-MA",
  "groups": [
    "evc/moped"
  ],
  "name": "Motorized Bicycle",
  "description": "Massachusetts's moped category: a pedal bicycle with a helper motor, or a non-pedal bicycle with a motor, with an automatic transmission and a top speed of no more than 30 mph. An e-bike that assists past 20 mph, or a pedal-less electric moped, lands here while it can't exceed 30 mph.",
  "throttle": true,
  "max_speed": 48.28,
  "restrictions": [
    {
      "rule": "A pedal bicycle with a helper motor or a non-pedal bicycle with a motor, and an automatic transmission",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Massachusetts General Laws chapter 90 §1",
      "sources": [
        "https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXIV/Chapter90/Section1"
      ]
    },
    {
      "rule": "Capable of no more than 30 mph; the definition also caps an engine at 50 cc",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Massachusetts General Laws chapter 90 §1",
      "sources": [
        "https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXIV/Chapter90/Section1"
      ]
    },
    {
      "rule": "A pedal-less electric moped is one while it can't exceed 30 mph; the RMV applies the 50 cc cap only to a gas engine and records an electric motor's watts",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Massachusetts General Laws chapter 90 §1",
      "sources": [
        "https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXIV/Chapter90/Section1",
        "https://www.mass.gov/doc/bicycle-conversion-to-motorized-bicycle-moped-affidavit-of-owner/download"
      ]
    },
    {
      "rule": "Not an electric bicycle (Class 1 or Class 2), and not a motor vehicle",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Massachusetts General Laws chapter 90 §1",
      "sources": [
        "https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXIV/Chapter90/Section1"
      ]
    },
    {
      "rule": "May not be ridden faster than 25 mph",
      "categories": [
        "rider_rule"
      ],
      "citation": "Massachusetts General Laws chapter 90 §1B",
      "sources": [
        "https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXIV/Chapter90/Section1B"
      ]
    },
    {
      "rule": "Breaking its age, speed, license, helmet or path rules is fined up to $25 for a first offense, $25 to $50 for a second and $50 to $100 after that",
      "categories": [
        "enforcement"
      ],
      "citation": "Massachusetts General Laws chapter 90 §1B",
      "sources": [
        "https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXIV/Chapter90/Section1B"
      ]
    },
    {
      "rule": "Riders must be 16 or older and hold a valid driver's license or learner's permit; a learner's permit holder needs no accompanying driver",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Massachusetts General Laws chapter 90 §§1B, 8B",
      "sources": [
        "https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXIV/Chapter90/Section1B",
        "https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXIV/Chapter90/Section8B"
      ]
    },
    {
      "rule": "Every rider and passenger must wear a helmet meeting the registrar's standards",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Massachusetts General Laws chapter 90 §1B",
      "sources": [
        "https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXIV/Chapter90/Section1B"
      ]
    },
    {
      "rule": "Must comply with the federal motor vehicle safety standards that apply to it",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Massachusetts General Laws chapter 90 §1C",
      "sources": [
        "https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXIV/Chapter90/Section1C"
      ]
    },
    {
      "rule": "The seller affixes a numbered RMV sticker or plate, renewed every two years",
      "categories": [
        "seller_rule"
      ],
      "citation": "Massachusetts General Laws chapter 90 §1D",
      "sources": [
        "https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXIV/Chapter90/Section1D"
      ]
    },
    {
      "rule": "May use all public ways and bike lanes beside them, except limited-access or express state highways posted against bicycles",
      "categories": [
        "rider_rule"
      ],
      "citation": "Massachusetts General Laws chapter 90 §1B",
      "sources": [
        "https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXIV/Chapter90/Section1B"
      ]
    },
    {
      "rule": "Barred from off-street recreational bicycle paths",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Massachusetts General Laws chapter 90 §1B",
      "sources": [
        "https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXIV/Chapter90/Section1B"
      ]
    }
  ]
}
