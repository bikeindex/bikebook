{
  "id": "evc/us/vt/motor_driven_cycle",
  "jurisdiction": "US-VT",
  "name": "Motor-Driven Cycle",
  "description": "A moped: two or three wheels and a power source of up to two brake horsepower (1,500 W) that can't propel it past 30 mph on a level road, with an automatic drive; an electric motor qualifies, since only a combustion engine is held to 50 cc.",
  "throttle": true,
  "max_speed": 48.28,
  "max_power": 1500,
  "restrictions": [
    {
      "rule": "Two or three wheels and a power drive system that works without clutching or shifting once engaged; pedals aren't required",
      "citation": "23 V.S.A. §4(45)(A)",
      "sources": [
        "https://legislature.vermont.gov/statutes/section/23/001/00004"
      ]
    },
    {
      "rule": "Its power source provides up to two brake horsepower (1,500 W) and can't propel it unassisted faster than 30 mph on a level road",
      "citation": "23 V.S.A. §4(45)(A)",
      "sources": [
        "https://legislature.vermont.gov/statutes/section/23/001/00004"
      ]
    },
    {
      "rule": "A motor vehicle, but not a motorcycle, electric bicycle or motor-assisted bicycle",
      "citation": "23 V.S.A. §§4(18)(A), 4(45)(A)",
      "sources": [
        "https://legislature.vermont.gov/statutes/section/23/001/00004"
      ]
    },
    {
      "rule": "Riders must be licensed drivers at least 16 years old; no motorcycle endorsement",
      "citation": "23 V.S.A. §601(e)",
      "sources": [
        "https://legislature.vermont.gov/statutes/section/23/009/00601",
        "https://legislature.vermont.gov/Documents/2026/Workgroups/House%20Transportation/Legislative%20Counsel/W~Damien%20Leonard~Electric%20Bike%20Laws%20in%20Vermont~1-14-2026.pdf",
        "https://dmv.vermont.gov/licenses/types-of-licenses-ids/motorcycle-endorsement"
      ]
    },
    {
      "rule": "No helmet requirement: Vermont's helmet law covers motorcycles, which exclude motor-driven cycles",
      "citation": "23 V.S.A. §§4(18)(A), 1256",
      "sources": [
        "https://legislature.vermont.gov/statutes/section/23/001/00004",
        "https://legislature.vermont.gov/statutes/section/23/013/01256"
      ]
    },
    {
      "rule": "Registered with the DMV each year and carries a plate, but exempt from title",
      "sources": [
        "https://dmv.vermont.gov/registrations/fees",
        "https://legislature.vermont.gov/Documents/2026/Workgroups/House%20Transportation/Legislative%20Counsel/W~Damien%20Leonard~Electric%20Bike%20Laws%20in%20Vermont~1-14-2026.pdf",
        "https://legislature.vermont.gov/statutes/section/23/007/00511"
      ]
    },
    {
      "rule": "Must carry liability insurance",
      "citation": "23 V.S.A. §800",
      "sources": [
        "https://legislature.vermont.gov/statutes/section/23/011/00800"
      ]
    },
    {
      "rule": "Needs a headlight and taillight from 30 minutes after sunset to 30 minutes before sunrise",
      "citation": "23 V.S.A. §1243",
      "sources": [
        "https://legislature.vermont.gov/Documents/2024/WorkGroups/Senate%20Transportation/Agency%20of%20Transportation/W~Jon%20Kaplan~VT%20Laws%20-%20Motorcycles%20-%20Bikes%20-%20Micromobility~3-1-2023.pdf",
        "https://legislature.vermont.gov/statutes/section/23/013/01243"
      ]
    },
    {
      "rule": "Ridden in the travel lanes like any motor vehicle",
      "citation": "23 V.S.A. §1115",
      "sources": [
        "https://legislature.vermont.gov/Documents/2024/WorkGroups/Senate%20Transportation/Agency%20of%20Transportation/W~Jon%20Kaplan~VT%20Laws%20-%20Motorcycles%20-%20Bikes%20-%20Micromobility~3-1-2023.pdf",
        "https://legislature.vermont.gov/statutes/section/23/013/01115"
      ]
    }
  ]
}
