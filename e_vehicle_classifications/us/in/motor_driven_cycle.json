{
  "id": "evc/us/in/motor_driven_cycle",
  "jurisdiction": "US-IN",
  "name": "Motor Driven Cycle",
  "description": "Indiana's moped and scooter category: a road-legal motor vehicle with a seat, no more than three wheels and a cylinder capacity of 50 cc or less, registered as a motor driven cycle and ridden at 35 mph or less. Its only size limit is that 50 cc cylinder capacity; it sets no power limit for an electric motor.",
  "throttle": true,
  "restrictions": [
    {
      "rule": "A seat or saddle, and no more than three wheels on the ground",
      "citation": "Indiana Code §9-13-2-104.1",
      "sources": [
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motorcycle-and-motor-driven-cycle-classifications",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=52"
      ]
    },
    {
      "rule": "A cylinder capacity of 50 cc or less; there's no power or wattage limit for an electric motor",
      "citation": "Indiana Code §9-13-2-104.1",
      "sources": [
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=52"
      ]
    },
    {
      "rule": "Being registered as a motor driven cycle is part of the definition, and one so registered isn't a motorcycle; one with operable pedals and a motor of 750 W or less that meets an e-bike class is an electric bicycle instead",
      "citation": "Indiana Code §9-13-2-104.1",
      "sources": [
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=36",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=52",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=53"
      ]
    },
    {
      "rule": "Built for highway use: meets federal motor vehicle safety standards (49 CFR 571) and Indiana's equipment rules, with a headlamp lit whenever it's ridden",
      "citation": "Indiana Code §§9-13-2-104.1, 9-19-7-2, 9-21-10-5",
      "sources": [
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motorcycle-and-motor-driven-cycle-classifications",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=52",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=449",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=310"
      ]
    },
    {
      "rule": "Riders must be 15 or older and carry a driver's license, a learner's permit, or a state ID card with a motor driven cycle endorsement, which takes a knowledge test",
      "citation": "Indiana Code §§9-21-11-12, 9-24-16-3.6",
      "sources": [
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motor-driven-cycles-frequently-asked-questions",
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motorcycle-and-motor-driven-cycle-classifications",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=452",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=601"
      ]
    },
    {
      "rule": "Riders and passengers under 18 must wear a DOT motorcycle helmet and protective glasses, goggles or a face shield",
      "citation": "Indiana Code §9-19-7-1",
      "sources": [
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motorcycle-and-motor-driven-cycle-classifications",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=310"
      ]
    },
    {
      "rule": "Registered with the BMV and carries a motor driven cycle plate; no title or insurance needed, and exempt from the electric vehicle supplemental fee",
      "citation": "Indiana Code §§9-17-1-1, 9-18.1-5-3, 9-18.1-5-12, 9-25-1-7",
      "sources": [
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motor-driven-cycles-frequently-asked-questions",
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motorcycle-and-motor-driven-cycle-classifications",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=123",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=175",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=180",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=624"
      ]
    },
    {
      "rule": "Can't be ridden faster than 35 mph, or carry a passenger",
      "citation": "Indiana Code §§9-21-10-1, 9-21-11-12",
      "sources": [
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motorcycle-and-motor-driven-cycle-classifications",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=449",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=452"
      ]
    },
    {
      "rule": "Kept as far right on the roadway as practicable, except to pass or turn left",
      "citation": "Indiana Code §9-21-8-2",
      "sources": [
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motorcycle-and-motor-driven-cycle-classifications",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=429"
      ]
    },
    {
      "rule": "Not allowed on interstate highways or sidewalks",
      "citation": "Indiana Code §§9-21-10-8, 9-21-11-12",
      "sources": [
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motorcycle-and-motor-driven-cycle-classifications",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=450",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=452"
      ]
    }
  ],
  "sources": [
    "https://iga.in.gov/ic/2026/Title_9.pdf"
  ]
}
