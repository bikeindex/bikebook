{
  "id": "evc/us/in/motorcycle",
  "jurisdiction": "US-IN",
  "groups": [
    "evc/motor_driven_cycle",
    "evc/motorcycle"
  ],
  "name": "Motorcycle",
  "description": "A road-registered motor vehicle with a seat and no more than three wheels that meets federal motor vehicle safety standards. Indiana draws no power or speed line for an electric motor: a street-legal electric two-wheeler that isn't an e-bike is a motorcycle unless it's registered as a motor driven cycle.",
  "throttle": true,
  "restrictions": [
    {
      "rule": "A seat or saddle, and no more than three wheels on the ground",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Indiana Code §9-13-2-108",
      "sources": [
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motorcycle-and-motor-driven-cycle-classifications",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=53"
      ]
    },
    {
      "rule": "No limit on motor power or speed, so one whose motor produces no more than 5 brake horsepower is a motorcycle unless it's registered as a motor driven cycle, which can't be ridden faster than 35 mph; excludes electric bicycles",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Indiana Code §§9-13-2-108, 9-21-11-12",
      "sources": [
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=53",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=452"
      ]
    },
    {
      "rule": "Built for highway use: meets federal motor vehicle safety standards (49 CFR 571) and Indiana's equipment rules, including brakes on both wheels, footrests and DOT lamps; an off-road e-moto without that certification is an off-road vehicle instead",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Indiana Code §§9-13-2-108, 9-19-7-2",
      "sources": [
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motorcycle-and-motor-driven-cycle-classifications",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=53",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=310"
      ]
    },
    {
      "rule": "Riders need a driver's license with a motorcycle endorsement, which takes a written and a skills test",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Indiana Code §9-24-8.5-3",
      "sources": [
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motorcycle-and-motor-driven-cycle-classifications",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=564"
      ]
    },
    {
      "rule": "With an approved motorcycle safety course, the endorsement takes an age of 16",
      "categories": [
        "rider_rule"
      ],
      "citation": "HEA 1200, 2026",
      "starts_on": "2026-07-01",
      "sources": [
        "https://iga.in.gov/pdf-documents/124/2026/house/bills/HB1200/HB1200.06.ENRS.pdf",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=564"
      ]
    },
    {
      "rule": "With an approved motorcycle safety course, the endorsement takes an age of 16 years and 90 days",
      "categories": [
        "rider_rule"
      ],
      "citation": "HEA 1200, 2026",
      "ends_on": "2026-07-01",
      "sources": [
        "https://iga.in.gov/pdf-documents/124/2026/house/bills/HB1200/HB1200.06.ENRS.pdf",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=564"
      ]
    },
    {
      "rule": "Without an approved motorcycle safety course, the endorsement takes an age of 16 years and 270 days",
      "categories": [
        "rider_rule"
      ],
      "citation": "HEA 1200, 2026",
      "sources": [
        "https://iga.in.gov/pdf-documents/124/2026/house/bills/HB1200/HB1200.06.ENRS.pdf",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=564"
      ]
    },
    {
      "rule": "A motorcycle learner's permit allows riding only in daylight, with no passengers and a DOT helmet",
      "categories": [
        "rider_rule"
      ],
      "citation": "Indiana Code §9-24-8-3",
      "sources": [
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=562"
      ]
    },
    {
      "rule": "Riders and passengers under 18 must wear a DOT motorcycle helmet and protective glasses, goggles or a face shield",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Indiana Code §9-19-7-1",
      "sources": [
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motorcycle-and-motor-driven-cycle-classifications",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=310"
      ]
    },
    {
      "rule": "Titled and registered with the BMV, and must carry liability insurance; an electric one also pays the electric vehicle supplemental registration fee",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Indiana Code §§9-18.1-3-2, 9-18.1-5-12",
      "sources": [
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motorcycle-and-motor-driven-cycle-classifications",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=168",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=180"
      ]
    },
    {
      "rule": "Headlamp lit whenever it's ridden; one passenger allowed on a seat built for one",
      "categories": [
        "rider_rule"
      ],
      "citation": "Indiana Code §§9-21-10-1, 9-21-10-5",
      "sources": [
        "https://www.in.gov/bmv/registration-plates/vehicle-registrations/motorcycles-and-motor-driven-cycles/motorcycle-and-motor-driven-cycle-classifications",
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=449"
      ]
    },
    {
      "rule": "Allowed on interstate highways",
      "categories": [
        "rider_rule"
      ],
      "citation": "Indiana Code §9-21-10-8",
      "sources": [
        "https://iga.in.gov/ic/2026/Title_9.pdf#page=450"
      ]
    }
  ],
  "sources": [
    "https://iga.in.gov/ic/2026/Title_9.pdf"
  ]
}
