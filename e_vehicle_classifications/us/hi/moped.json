{
  "id": "evc/us/hi/moped",
  "jurisdiction": "US-HI",
  "groups": [
    "evc/moped"
  ],
  "name": "Moped",
  "description": "A two- or three-wheeler whose motor, electric or combustion, produces 2 horsepower (1,500 W) or less and can't propel it faster than 30 mph on level ground, with an automatic drive.",
  "throttle": true,
  "max_speed": 48.28,
  "max_power": 1500,
  "restrictions": [
    {
      "rule": "Two or three wheels and a direct or automatic drive that needs no clutch or gear shifting",
      "citation": "Hawaii Revised Statutes §§286-2, 291C-1",
      "sources": [
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0286/HRS_0286-0002.htm",
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0291C/HRS_0291C-0001.htm"
      ]
    },
    {
      "rule": "Its motor produces 2 horsepower (1,500 W) or less at the output shaft; a combustion engine is also limited to 50 cc",
      "citation": "Hawaii Revised Statutes §§286-2, 291C-1",
      "sources": [
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0286/HRS_0286-0002.htm",
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0291C/HRS_0291C-0001.htm"
      ]
    },
    {
      "rule": "Can't propel it faster than 30 mph on level ground; one that can is a motor-driven cycle instead",
      "citation": "Hawaii Revised Statutes §§286-2, 291C-1",
      "sources": [
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0286/HRS_0286-0002.htm",
        "https://data.capitol.hawaii.gov/sessions/session2026/bills/HB2021_CD1_.HTM",
        "https://hidot.hawaii.gov/highways/files/2026/01/Information-for-MOPED-Owners-and-Drivers-REV-2026-12-31.pdf",
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0291C/HRS_0291C-0001.htm"
      ]
    },
    {
      "rule": "A bicycle whose motor exceeds an electric bicycle's 750 W but stays within these limits meets this definition; an unregistered one over 750 W that can exceed 28 mph is a high-speed electric device",
      "citation": "Hawaii Revised Statutes §§286-2, 291C-1, as amended by HB 2021 (2026)",
      "sources": [
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0286/HRS_0286-0002.htm",
        "https://data.capitol.hawaii.gov/sessions/session2026/bills/HB2021_CD1_.HTM",
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0291C/HRS_0291C-0001.htm"
      ]
    },
    {
      "rule": "Must carry the manufacturer's label certifying it meets federal motor vehicle safety standards to be registered",
      "sources": [
        "https://hidot.hawaii.gov/highways/files/2026/01/Information-for-MOPED-Owners-and-Drivers-REV-2026-12-31.pdf"
      ]
    },
    {
      "rule": "Registered every year with the county director of finance for $27, with a plate on the rear, and must pass an annual safety inspection",
      "citation": "Hawaii Revised Statutes §§249-14.1, 286-26",
      "sources": [
        "https://data.capitol.hawaii.gov/hrscurrent/Vol04_Ch0201-0257/HRS0249/HRS_0249-0014_0001.htm",
        "https://hidot.hawaii.gov/highways/files/2026/01/Information-for-MOPED-Owners-and-Drivers-REV-2026-12-31.pdf",
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0286/HRS_0286-0026.htm"
      ]
    },
    {
      "rule": "Riders must be 16 or older and carry a driver's license of any class, including the moped-only Class 1, or an instruction permit",
      "citation": "Act 222, 2025",
      "sources": [
        "https://data.capitol.hawaii.gov/sessions/sessionlaws/Years/SLH2025/SLH2025_Act222.pdf",
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0291C/HRS_0291C-0195.htm",
        "https://hidot.hawaii.gov/highways/files/2026/01/Information-for-MOPED-Owners-and-Drivers-REV-2026-12-31.pdf",
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0286/HRS_0286-0102.htm"
      ]
    },
    {
      "rule": "Every rider must wear a safety helmet fastened with a chin strap, at any age, since June 25, 2025",
      "citation": "Act 222, 2025",
      "sources": [
        "https://data.capitol.hawaii.gov/sessions/sessionlaws/Years/SLH2025/SLH2025_Act222.pdf",
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0291C/HRS_0291C-0195.htm"
      ]
    },
    {
      "rule": "Ridden seated astride and facing forward, with no passenger, except a three-wheeled moped with side-by-side seats",
      "citation": "Hawaii Revised Statutes §291C-195",
      "sources": [
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0291C/HRS_0291C-0195.htm",
        "https://hidot.hawaii.gov/highways/files/2026/01/Information-for-MOPED-Owners-and-Drivers-REV-2026-12-31.pdf"
      ]
    },
    {
      "rule": "No insurance required for a two-wheeled moped; a three-wheeled one must carry liability and property damage coverage",
      "citation": "Hawaii Revised Statutes §291C-195(e)",
      "sources": [
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0291C/HRS_0291C-0195.htm",
        "https://hidot.hawaii.gov/highways/files/2026/01/Information-for-MOPED-Owners-and-Drivers-REV-2026-12-31.pdf"
      ]
    },
    {
      "rule": "May not be driven faster than 35 mph; a three-wheeled moped is limited to roads posted 35 mph or less",
      "citation": "Hawaii Revised Statutes §§291C-196, 291C-198",
      "sources": [
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0291C/HRS_0291C-0196.htm",
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0291C/HRS_0291C-0198.htm"
      ]
    },
    {
      "rule": "Not allowed on freeways, sidewalks or pedestrian paths, and since July 15, 2026 barred from bike lanes, bike paths and any path or roadway designated for bicycles",
      "citation": "HB 2021, 2026",
      "sources": [
        "https://data.capitol.hawaii.gov/sessions/session2026/bills/HB2021_CD1_.HTM",
        "https://data.capitol.hawaii.gov/hrscurrent/Vol05_Ch0261-0319/HRS0291C/HRS_0291C-0196.htm",
        "https://hidot.hawaii.gov/highways/files/2026/01/Information-for-MOPED-Owners-and-Drivers-REV-2026-12-31.pdf",
        "https://hidot.hawaii.gov/blog/2026/07/16/new-law-enacted-to-improve-electric-bicycle-safety/"
      ]
    }
  ],
  "sources": [
    "https://data.capitol.hawaii.gov/sessions/session2025/bills/SB30_CD1_.HTM"
  ]
}
