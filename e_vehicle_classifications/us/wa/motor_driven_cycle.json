{
  "id": "evc/us/wa/motor_driven_cycle",
  "jurisdiction": "US-WA",
  "groups": [
    "evc/motor_driven_cycle"
  ],
  "name": "Motor-Driven Cycle",
  "description": "A light motorcycle, motor scooters included, whose motor produces no more than five brake horsepower (3,750 W); an electric two-wheeler too fast or powerful to be a moped but within that limit lands here.",
  "throttle": true,
  "max_power": 3750,
  "restrictions": [
    {
      "rule": "A motorcycle: a seat or saddle, handlebar steering, and no more than three wheels",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Revised Code of Washington §§46.04.332, 46.04.330",
      "sources": [
        "https://app.leg.wa.gov/RCW/default.aspx?cite=46.04.332",
        "https://app.leg.wa.gov/RCW/default.aspx?cite=46.04.330"
      ]
    },
    {
      "rule": "Its motor produces no more than five brake horsepower (3,750 W); one over two brake horsepower (1,500 W) or faster than 30 mph is no longer a moped",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Revised Code of Washington §§46.04.332, 46.04.304",
      "sources": [
        "https://app.leg.wa.gov/RCW/default.aspx?cite=46.04.332",
        "https://app.leg.wa.gov/RCW/default.aspx?cite=46.04.304"
      ]
    },
    {
      "rule": "Not a moped, motorized foot scooter or electric-assisted bicycle",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Revised Code of Washington §§46.04.332, 46.04.330",
      "sources": [
        "https://app.leg.wa.gov/RCW/default.aspx?cite=46.04.332",
        "https://app.leg.wa.gov/RCW/default.aspx?cite=46.04.330"
      ]
    },
    {
      "rule": "Anything able to exceed 20 mph on its motor alone, or built or sold to be easily switched out of the e-bike limits, isn't an e-bike; one past the moped's 1,500 W or 30 mph but within 3,750 W is a motor-driven cycle",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "Revised Code of Washington §§46.04.169, 46.04.332; ESSB 6110 (2026)",
      "starts_on": "2026-06-11",
      "sources": [
        "https://app.leg.wa.gov/RCW/default.aspx?cite=46.04.169",
        "https://app.leg.wa.gov/RCW/default.aspx?cite=46.04.332",
        "https://lawfilesext.leg.wa.gov/biennium/2025-26/Htm/Bills/Session%20Laws/Senate/6110-S.SL.htm"
      ]
    },
    {
      "rule": "Riders need a driver's license with a motorcycle endorsement",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Revised Code of Washington §46.20.500",
      "sources": [
        "https://app.leg.wa.gov/RCW/default.aspx?cite=46.20.500"
      ]
    },
    {
      "rule": "Every rider and passenger must wear a motorcycle helmet on a state highway, county road or city street",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Revised Code of Washington §46.37.530",
      "sources": [
        "https://app.leg.wa.gov/RCW/default.aspx?cite=46.37.530"
      ]
    },
    {
      "rule": "The operator must wear glasses, goggles or a face shield unless it has a windshield, and it needs mirrors on both sides",
      "categories": [
        "rider_rule",
        "vehicle_definition"
      ],
      "citation": "Revised Code of Washington §46.37.530",
      "sources": [
        "https://app.leg.wa.gov/RCW/default.aspx?cite=46.37.530"
      ]
    },
    {
      "rule": "Registered and plated with the Department of Licensing",
      "categories": [
        "rider_rule",
        "top_rule"
      ],
      "citation": "Revised Code of Washington §46.16A.030",
      "sources": [
        "https://app.leg.wa.gov/RCW/default.aspx?cite=46.16A.030"
      ]
    },
    {
      "rule": "Exempt from the liability insurance requirement",
      "categories": [
        "rider_rule"
      ],
      "citation": "Revised Code of Washington §46.30.020",
      "sources": [
        "https://app.leg.wa.gov/RCW/default.aspx?cite=46.30.020"
      ]
    }
  ]
}
