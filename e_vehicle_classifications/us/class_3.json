{
  "id": "evc/us/class_3",
  "jurisdiction": "US",
  "name": "Class 3",
  "description": "A speed pedal-assist electric bicycle: the motor helps only while the rider pedals, and stops helping at 28 mph. Every class is also a federal low-speed electric bicycle (evc/us/low_speed_electric_bicycle).",
  "throttle": false,
  "max_speed": 45.06,
  "max_power": 750,
  "restrictions": [
    {
      "rule": "Fully operable pedals, a saddle or seat, and a motor of less than 750 watts",
      "citation": "23 U.S.C. §217(j)(2)",
      "sources": [
        "https://peopleforbikes.cdn.prismic.io/peopleforbikes/3686d20b-5695-47c1-b0c7-ffe06402be55_Model-eBike-Legislation-Jan2020.pdf",
        "https://www.govinfo.gov/link/uscode/23/217"
      ]
    },
    {
      "rule": "No throttle: the motor assists only while the rider is pedaling",
      "citation": "23 U.S.C. §217(j)(2)",
      "sources": [
        "https://peopleforbikes.cdn.prismic.io/peopleforbikes/3686d20b-5695-47c1-b0c7-ffe06402be55_Model-eBike-Legislation-Jan2020.pdf",
        "https://www.govinfo.gov/link/uscode/23/217"
      ]
    },
    {
      "rule": "The motor stops assisting at 28 mph, and disengages when the rider stops pedaling or applies the brakes",
      "citation": "23 U.S.C. §217(j)(2)",
      "sources": [
        "https://peopleforbikes.cdn.prismic.io/peopleforbikes/3686d20b-5695-47c1-b0c7-ffe06402be55_Model-eBike-Legislation-Jan2020.pdf",
        "https://www.govinfo.gov/link/uscode/23/217"
      ]
    },
    {
      "rule": "Must have a speedometer showing its speed in miles per hour",
      "sources": [
        "https://peopleforbikes.cdn.prismic.io/peopleforbikes/3686d20b-5695-47c1-b0c7-ffe06402be55_Model-eBike-Legislation-Jan2020.pdf"
      ]
    },
    {
      "rule": "Riders must be 16 or older; a younger passenger may ride on one designed to carry passengers",
      "sources": [
        "https://peopleforbikes.cdn.prismic.io/peopleforbikes/3686d20b-5695-47c1-b0c7-ffe06402be55_Model-eBike-Legislation-Jan2020.pdf"
      ]
    },
    {
      "rule": "Riders and passengers must wear a bicycle helmet meeting CPSC or ASTM standards",
      "sources": [
        "https://peopleforbikes.cdn.prismic.io/peopleforbikes/3686d20b-5695-47c1-b0c7-ffe06402be55_Model-eBike-Legislation-Jan2020.pdf"
      ]
    },
    {
      "rule": "Carries a permanent label stating its class, top assisted speed and motor wattage",
      "sources": [
        "https://peopleforbikes.cdn.prismic.io/peopleforbikes/3686d20b-5695-47c1-b0c7-ffe06402be55_Model-eBike-Legislation-Jan2020.pdf"
      ]
    },
    {
      "rule": "Must not be modified to change its motor-powered speed or engagement unless the label is replaced to match",
      "sources": [
        "https://peopleforbikes.cdn.prismic.io/peopleforbikes/3686d20b-5695-47c1-b0c7-ffe06402be55_Model-eBike-Legislation-Jan2020.pdf"
      ]
    },
    {
      "rule": "Meets the CPSC's bicycle requirements",
      "citation": "16 CFR part 1512",
      "sources": [
        "https://peopleforbikes.cdn.prismic.io/peopleforbikes/3686d20b-5695-47c1-b0c7-ffe06402be55_Model-eBike-Legislation-Jan2020.pdf",
        "https://www.ecfr.gov/current/title-16/chapter-II/subchapter-C/part-1512"
      ]
    },
    {
      "rule": "A local authority may ban it from any bicycle or multi-use path, with no hearing needed",
      "sources": [
        "https://peopleforbikes.cdn.prismic.io/peopleforbikes/3686d20b-5695-47c1-b0c7-ffe06402be55_Model-eBike-Legislation-Jan2020.pdf"
      ]
    },
    {
      "rule": "On a natural-surface trail designated nonmotorized, the agency that manages the trail decides whether it's allowed",
      "sources": [
        "https://peopleforbikes.cdn.prismic.io/peopleforbikes/3686d20b-5695-47c1-b0c7-ffe06402be55_Model-eBike-Legislation-Jan2020.pdf"
      ]
    },
    {
      "rule": "Treated as a bicycle, not a motor vehicle: no driver's license, registration or insurance",
      "sources": [
        "https://peopleforbikes.cdn.prismic.io/peopleforbikes/3686d20b-5695-47c1-b0c7-ffe06402be55_Model-eBike-Legislation-Jan2020.pdf"
      ]
    }
  ]
}
