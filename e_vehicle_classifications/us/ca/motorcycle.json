{
  "id": "evc/us/ca/motorcycle",
  "jurisdiction": "US-CA",
  "groups": [
    "evc/motorcycle"
  ],
  "name": "Motorcycle",
  "description": "A road-registered electric motorcycle: its motor produces more than 5 gross brake horsepower (3,750 W), above what a motor-driven cycle may.",
  "limits_start_on": "2027-01-01",
  "throttle": true,
  "min_power": 3750,
  "restrictions": [
    {
      "rule": "A seat or saddle, and no more than three wheels on the ground",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "California Vehicle Code §400",
      "sources": [
        "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=VEH&sectionNum=400"
      ]
    },
    {
      "rule": "Its motor produces more than 5 gross brake horsepower (3,750 W)",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "SB 1167, 2026",
      "starts_on": "2027-01-01",
      "sources": [
        "https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202520260SB1167"
      ]
    },
    {
      "rule": "One designed primarily for off-highway use, with two wheels, a straddle seat and no pedals, is an off-highway electric motorcycle instead",
      "categories": [
        "vehicle_definition"
      ],
      "citation": "California Vehicle Code §436.1",
      "sources": [
        "https://ohv.parks.ca.gov/pages/1234/files/OHV%20Information%20Bulletin%2025-1%20SB-586%20Electric%20Motorcycles%20ADA%20Final.pdf",
        "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=VEH&sectionNum=436.1"
      ]
    },
    {
      "rule": "Riders need a driver's license with an M1 motorcycle endorsement",
      "categories": [
        "rider_rule"
      ],
      "citation": "California Vehicle Code §§12500, 12804.9",
      "sources": [
        "https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202520260SB1167",
        "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=VEH&sectionNum=12500"
      ]
    },
    {
      "rule": "Riders must wear a motorcycle helmet",
      "categories": [
        "rider_rule"
      ],
      "citation": "California Vehicle Code §27803",
      "sources": [
        "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=VEH&sectionNum=27803"
      ]
    },
    {
      "rule": "Registered and plated with the DMV, and must carry liability insurance",
      "categories": [
        "rider_rule"
      ],
      "citation": "California Vehicle Code §§4000, 16020",
      "sources": [
        "https://www.dmv.ca.gov/portal/vehicle-registration/new-registration/motorcycles-mopeds-and-scooters/",
        "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=VEH&sectionNum=4000",
        "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=VEH&sectionNum=16020"
      ]
    },
    {
      "rule": "Allowed on freeways",
      "categories": [
        "rider_rule"
      ],
      "citation": "California Vehicle Code §21960",
      "sources": [
        "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=VEH&sectionNum=21960"
      ]
    },
    {
      "rule": "Kept out of bike lanes except to park, enter or leave the road, or prepare to turn, and off any trail or bike path posted against unauthorized motor vehicles",
      "categories": [
        "rider_rule"
      ],
      "citation": "California Vehicle Code §§21209, 23127",
      "sources": [
        "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=VEH&sectionNum=21209",
        "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=VEH&sectionNum=23127"
      ]
    },
    {
      "rule": "A vehicle, not property: it can be towed or impounded",
      "categories": [
        "enforcement"
      ],
      "citation": "California Vehicle Code §§670, 22651",
      "sources": [
        "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=VEH&sectionNum=670",
        "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=VEH&sectionNum=22651"
      ]
    },
    {
      "rule": "A peace officer may remove it when its rider isn't licensed to ride it and its motor alone can propel it faster than 20 mph; it's released after at least 48 hours, once the removal and storage costs are paid",
      "categories": [
        "enforcement"
      ],
      "citation": "California Vehicle Code §22651.08, added by AB 875 (2025)",
      "sources": [
        "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=VEH&sectionNum=22651.08",
        "https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202520260AB875"
      ]
    }
  ]
}
