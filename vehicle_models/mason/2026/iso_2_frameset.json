  "components": [
    {
      "type": "axle_nuts",
      "type_detail": "Axles",
      "description": "The InSearchOf is designed around the 'BOOST' standard. The front hub is 10mm wider and the rear is 6mm wider than 100/142mm standard road thru-axle spec., allowing wider wheels and high volume tyres with larger clearances front and rear. The wider hub flanges result in a hugely stiffer wheel, giving enhanced bike handling and shorter/wider stays allow progressive geometry, whilst a wider rear hub helps give a greater choice of chainrings."
    },
    {
      "type": "brake_rotor",
      "type_detail": "Rotor Size",
      "position": [
        "front",
        "rear"
      ],
      "description": "The fork can take Ø160mm or Ø180mm rotor [using standard 140/160 adaptor]. Mason Cycles is the first to develop the 160/180 Flat-Mount standard for a rigid fork. Ø160mm is recommended at the rear using an appropriate flat-mount adapter."
    },
    {
      "type": "chainrings",
      "type_detail": "Max 1x chainring size",
      "description": "34T with 52mm chainline. 36T with 55mm chainline."
    },
    {
      "type": "fender",
      "type_detail": "'Shutter' mudguard included",
      "description": "our own unique load-bearing design, holding up to 2kg: designed to provide extra load space and protection from debris"
    },
    {
      "type": "fork",
      "description": "Updated HotShoe2 carbon fork, designed by MASON. Featuring ‘Tri-Mount’ crown system for use with our Shutter mudguard and Condenser2 rack. Internally routed for dynamo light systems and updated eyelet positions for racks and mudguards"
    },
    {
      "type": "fork",
      "type_detail": "HOTSHOE FORK Dimensions",
      "description": "Crown height - 483mm [Equal to a typical 100mm travel XC suspension fork with 20% sag]. Offset - 50mm.",
